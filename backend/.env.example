HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
UPLOAD_DIR=./uploads
# true is safe by default and only logs a simulated notification.
DEMO_NOTIFICATIONS=true
# Real outbound calls use Twilio Programmable Voice. Set DEMO_NOTIFICATIONS=false
# only after configuring all values below. Phone numbers must use E.164 format.
# TWILIO_ACCOUNT_SID=AC................................
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550100
# TRUSTED_CONTACTS=+15555550101,+15555550102
# TWILIO_TRIAL_MODE=false
MAX_AUDIO_BYTES=8388608
MAX_SESSION_AUDIO_BYTES=104857600
MAX_LOCATIONS=20000
